{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "backend/app/static",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?path="
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?path=:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
