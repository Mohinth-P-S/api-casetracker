{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "backend/app/static",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.py"
    }
  ]
}
